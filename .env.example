LOG_LEVEL=INFO
MODEL_NAME=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=512
LLM_THINKING_BUDGET=200
LLM_SEED=42
RETRIEVAL_API_URL=http://127.0.0.1:7860
DEFAULT_ANSWER=Je ne dispose pas d'informations sur ce sujet.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GOOGLE_API_KEY=
API_HF_TOKEN=
HF_ORG_NAME=guild-open-tech
HF_DATASET_NAME=chroma-data
COLLECTION_NAME=miss_terry
ENABLE_RAGAS_EVAL=true
RAGAS_LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
EMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_CACHE_DIR=./.cache/hf
LOG_FILE=./logs/app.log
API_URL=

# --- FAQ step ---
FAQ_JSON_PATH=data/260817_FAQ_Miss_Terry.json
FAQ_EMBED_MODEL_NAME=intfloat/multilingual-e5-small
FAQ_TOP_K=3
FAQ_SIMILARITY_THRESHOLD=0.85
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
# score cross-encoder >= FAQ_ACCEPT_THRESHOLD -> réponse FAQ directe
FAQ_ACCEPT_THRESHOLD=0.96
# FAQ_JUDGE_THRESHOLD <= score < FAQ_ACCEPT_THRESHOLD -> LLM juge ; en dessous -> RAG
FAQ_JUDGE_THRESHOLD=0.60

# --- LLM juge (Gemini) ---
JUDGE_MODEL_NAME=gemini-2.5-flash
JUDGE_TEMPERATURE=0.0
JUDGE_THINKING_BUDGET=0
JUDGE_MAX_OUTPUT_TOKENS=256
